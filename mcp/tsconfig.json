{
  "compilerOptions": {
    "target": "ES2022",
    // DOM.Iterable: the node:http -> fetch bridge in realclient.test.ts iterates Headers.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Production runs the source under Node's type stripping, with no build step.
    // That needs `.ts` import paths and type-only imports marked `type`.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node's type stripping rejects enums, namespaces and parameter properties at load.
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    // "node" is required: the real-client test runs an http server and uses Buffer.
    "types": ["vitest/globals", "node"]
  },
  // ../src/data and ../src/types are the site's own content files. Reading them
  // directly is the point: the server and the site cannot report different work.
  "include": ["src", "../src/data/**/*.ts", "../src/types/**/*.ts"],
  "exclude": ["node_modules", "../src/data/**/*.test.ts"]
}
