{
  "name": "laikahkeen-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite-ssg build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,html,css,scss,md}\"",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mcp": "npm --prefix mcp run test:run",
    "test:all": "npm run test:run && npm run test:mcp",
    "check": "npm run lint && npm run type-check && npm --prefix mcp run type-check && npm run test:all",
    "audit": "audit-ci --config audit-ci.jsonc && audit-ci --config audit-ci.jsonc --directory mcp --show-not-found false"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "axios": "^1.20.0",
    "gsap": "^3.12.5",
    "lenis": "^1.0.42",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.16",
    "chrome-devtools-mcp": "^0.12.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "markdown-it": "^15.0.2",
    "postcss": "^8.4.32",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
